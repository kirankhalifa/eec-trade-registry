{
  "name": "eec-trade-registry",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @eec/portal",
    "build": "npm run build --workspace @eec/portal",
    "lint": "npm run lint --workspace @eec/portal",
    "typecheck": "npm run typecheck --workspace @eec/portal",
    "test": "npm run test --workspace @eec/portal",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning"
  },
  "devDependencies": {
    "supabase": "2.111.0"
  }
}

# Public Supabase project values. The anon/publishable key is safe for browser use
# only because database grants and RLS remain the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Exact trusted portal origin used for OAuth redirects. Production must use HTTPS.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Presentation-only configuration. These values never grant authority.
NEXT_PUBLIC_INSTITUTION_NAME=East Empire Company
NEXT_PUBLIC_DEFAULT_LOCALE=en-US

# Server-only integration environment. Never prefix these values with NEXT_PUBLIC.
# The service-role key is used only by the scheduled projection worker.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
CRON_SECRET=replace-with-at-least-16-random-characters
INTEGRATION_WORKER_ID=vercel-integrations

# Google service account with edit access to the configured spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account-email
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# Discord public interactions, channel notifications, and command registration.
DISCORD_APPLICATION_ID=replace-with-discord-application-id
DISCORD_PUBLIC_KEY=replace-with-64-character-discord-public-key
DISCORD_BOT_TOKEN=replace-with-server-only-discord-bot-token
# Optional: guild-scoped commands update immediately; omit for global commands.
DISCORD_GUILD_ID=replace-with-development-guild-id
